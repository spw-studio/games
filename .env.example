# OAuth Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Multi-tenancy (Fase 2)
# Organização (tenant) de bootstrap enquanto não existirem memberships persistidos
TENANT_DEFAULT_ORG_ID=org-default

# Lista branca opcional de e-mails com acesso (separados por vírgula)
# Vazio = qualquer conta Google pode entrar (comportamento histórico)
AUTH_EMAIL_ALLOWLIST=

# PostgreSQL (Fase 3) — vazio = modo fallback (identidade sem banco, como na Fase 2)
# Comando de migração: npm run db:migrate   |   Seed: npm run db:seed
DATABASE_URL=

# Organização criada no primeiro login quando a base está vazia (bootstrap)
TENANT_DEFAULT_ORG_NAME=Organização Padrão

# SUPER_ADMIN de plataforma (gerencia organizações) — e-mails separados por vírgula
SUPER_ADMIN_EMAILS=

